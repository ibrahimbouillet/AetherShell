function(aether_test_payload target version tampered)
    set(_directory "${CMAKE_CURRENT_BINARY_DIR}/${target}-resources")
    file(MAKE_DIRECTORY "${_directory}")
    set(_manifest "{\"schemaVersion\":1,\"product\":\"AetherShell\",\"version\":\"${version}\",\"architecture\":\"${AETHER_TARGET_ARCH}\",\"files\":[")
    set(_resources "// SPDX-License-Identifier: MIT\n// Copyright (c) 2026 Ibrahim Bouillet\n")
    set(_index 0)
    foreach(_name AetherShell.exe AetherShellApp.exe AetherShellUpdater.exe LICENSE THIRD_PARTY_NOTICES.md)
        set(_file "${_directory}/file-${_index}.txt")
        file(WRITE "${_file}" "Aether Shell synthetic resource ${_index}, version ${version}\n")
        file(SIZE "${_file}" _size)
        file(SHA256 "${_file}" _sha256)
        if(NOT _index EQUAL 0)
            string(APPEND _manifest ",")
        endif()
        string(APPEND _manifest "{\"name\":\"${_name}\",\"resource\":\"FILE_${_index}\",\"size\":${_size},\"sha256\":\"${_sha256}\"}")
        if(tampered AND _index EQUAL 0)
            file(WRITE "${_file}" "Xether Shell synthetic resource ${_index}, version ${version}\n")
        endif()
        string(APPEND _resources "FILE_${_index} RCDATA \"${_file}\"\n")
        math(EXPR _index "${_index}+1")
    endforeach()
    string(APPEND _manifest "]}")
    file(WRITE "${_directory}/manifest.json" "${_manifest}")
    string(APPEND _resources "PAYLOAD_MANIFEST RCDATA \"${_directory}/manifest.json\"\n")
    file(WRITE "${_directory}/payload.rc" "${_resources}")
    add_library(${target} SHARED "${PROJECT_SOURCE_DIR}/tests/integration/install/fixture/Fixture.cpp" "${_directory}/payload.rc")
    aether_apply_compile_options(${target})
    aether_apply_link_options(${target})
    set_target_properties(${target} PROPERTIES FOLDER "tests")
endfunction()
aether_test_payload(aether_install_payload_fixture 1.0.0 FALSE)
aether_test_payload(aether_install_invalid_fixture 1.0.0 TRUE)
aether_test_payload(aether_install_upgrade_fixture 2.0.0 FALSE)
if(TARGET aether_install_integration_tests)
    add_dependencies(aether_install_integration_tests aether_install_payload_fixture aether_install_invalid_fixture aether_install_upgrade_fixture)
endif()
