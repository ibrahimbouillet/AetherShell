{{L"Start Aether Shell when I sign in", L"D\u00E9marrer Aether Shell \u00E0 l'ouverture de session", L"Iniciar Aether Shell al iniciar sesi\u00F3n", L"\u767B\u5F55\u65F6\u542F\u52A8 Aether Shell", L"\u0938\u093E\u0907\u0928 \u0907\u0928 \u0915\u0930\u0928\u0947 \u092A\u0930 Aether Shell \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902"}},
{{L"Changing this needs Apply. Task Manager can also turn it off.", L"Ce changement n\u00E9cessite Appliquer. Le Gestionnaire des t\u00E2ches peut aussi le d\u00E9sactiver.", L"Este cambio requiere Aplicar. El Administrador de tareas tambi\u00E9n puede desactivarlo.", L"\u66F4\u6539\u6B64\u9879\u9700\u8981\u70B9\u51FB\u201C\u5E94\u7528\u201D\u3002\u4EFB\u52A1\u7BA1\u7406\u5668\u4E5F\u53EF\u4EE5\u5C06\u5176\u5173\u95ED\u3002", L"\u0907\u0938\u0947 \u092C\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0932\u093E\u0917\u0942 \u0915\u0930\u0947\u0902 \u0926\u092C\u093E\u090F\u0901\u0964 \u091F\u093E\u0938\u094D\u0915 \u092E\u0948\u0928\u0947\u091C\u0930 \u092D\u0940 \u0907\u0938\u0947 \u092C\u0902\u0926 \u0915\u0930 \u0938\u0915\u0924\u093E \u0939\u0948\u0964"}},
