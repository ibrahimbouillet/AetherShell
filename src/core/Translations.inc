{{L"Installs for your account", L"S'installe pour votre compte", L"Se instala para tu cuenta", L"\u4E3A\u4F60\u7684\u5E10\u6237\u5B89\u88C5", L"\u0906\u092A\u0915\u0947 \u0916\u093E\u0924\u0947 \u0915\u0947 \u0932\u093F\u090F \u0907\u0902\u0938\u094D\u091F\u0949\u0932 \u0939\u094B\u0924\u093E \u0939\u0948", L"Instala para a sua conta", L"\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0439 \u0443\u0447\u0451\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438", L"\u064A\u064F\u062B\u0628\u064E\u0651\u062A \u0644\u062D\u0633\u0627\u0628\u0643", L"\u0986\u09AA\u09A8\u09BE\u09B0 \u0985\u09CD\u09AF\u09BE\u0995\u09BE\u0989\u09A8\u09CD\u099F\u09C7\u09B0 \u099C\u09A8\u09CD\u09AF \u0987\u09A8\u09B8\u09CD\u099F\u09B2 \u09B9\u09AF\u09BC", L"\u0622\u067E \u06A9\u06D2 \u0627\u06A9\u0627\u0624\u0646\u0679 \u06A9\u06D2 \u0644\u06CC\u06D2 \u0627\u0646\u0633\u0679\u0627\u0644 \u06C1\u0648\u062A\u0627 \u06C1\u06D2"}},
{{L"No administrator rights are needed. Your settings and data stay in your user profile.", L"Aucun droit d'administrateur n'est n\u00E9cessaire. Vos param\u00E8tres et vos donn\u00E9es restent dans votre profil utilisateur.", L"No se necesitan permisos de administrador. Tu configuraci\u00F3n y tus datos se quedan en tu perfil de usuario.", L"\u65E0\u9700\u7BA1\u7406\u5458\u6743\u9650\u3002\u4F60\u7684\u8BBE\u7F6E\u548C\u6570\u636E\u90FD\u4FDD\u5B58\u5728\u4F60\u7684\u7528\u6237\u914D\u7F6E\u6587\u4EF6\u4E2D\u3002", L"\u0935\u094D\u092F\u0935\u0938\u094D\u0925\u093E\u092A\u0915 \u0905\u0927\u093F\u0915\u093E\u0930\u094B\u0902 \u0915\u0940 \u091C\u093C\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902\u0964 \u0906\u092A\u0915\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u0914\u0930 \u0921\u0947\u091F\u093E \u0906\u092A\u0915\u0940 \u0909\u092A\u092F\u094B\u0917\u0915\u0930\u094D\u0924\u093E \u092A\u094D\u0930\u094B\u092B\u093C\u093E\u0907\u0932 \u092E\u0947\u0902 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964", L"N\u00E3o s\u00E3o necess\u00E1rios direitos de administrador. Suas configura\u00E7\u00F5es e dados ficam no seu perfil de usu\u00E1rio.", L"\u041F\u0440\u0430\u0432\u0430 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0430 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F. \u0412\u0430\u0448\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438 \u0434\u0430\u043D\u043D\u044B\u0435 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0432 \u0432\u0430\u0448\u0435\u043C \u043F\u0440\u043E\u0444\u0438\u043B\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F.", L"\u0644\u0627 \u062D\u0627\u062C\u0629 \u0625\u0644\u0649 \u0635\u0644\u0627\u062D\u064A\u0627\u062A \u0627\u0644\u0645\u0633\u0624\u0648\u0644. \u062A\u0628\u0642\u0649 \u0625\u0639\u062F\u0627\u062F\u0627\u062A\u0643 \u0648\u0628\u064A\u0627\u0646\u0627\u062A\u0643 \u0641\u064A \u0645\u0644\u0641 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u062E\u0627\u0635 \u0628\u0643.", L"\u0985\u09CD\u09AF\u09BE\u09A1\u09AE\u09BF\u09A8\u09BF\u09B8\u09CD\u099F\u09CD\u09B0\u09C7\u099F\u09B0 \u0985\u09A7\u09BF\u0995\u09BE\u09B0 \u09B2\u09BE\u0997\u09C7 \u09A8\u09BE\u0964 \u0986\u09AA\u09A8\u09BE\u09B0 \u09B8\u09C7\u099F\u09BF\u0982\u09B8 \u0993 \u09A1\u09C7\u099F\u09BE \u0986\u09AA\u09A8\u09BE\u09B0 \u0987\u0989\u099C\u09BE\u09B0 \u09AA\u09CD\u09B0\u09CB\u09AB\u09BE\u0987\u09B2\u09C7\u0987 \u09A5\u09BE\u0995\u09C7\u0964", L"\u0627\u06CC\u0688\u0645\u0646\u0633\u0679\u0631\u06CC\u0679\u0631 \u06A9\u06D2 \u062D\u0642\u0648\u0642 \u062F\u0631\u06A9\u0627\u0631 \u0646\u06C1\u06CC\u06BA\u06D4 \u0622\u067E \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0627\u0648\u0631 \u0688\u06CC\u0679\u0627 \u0622\u067E \u06A9\u06D2 \u0635\u0627\u0631\u0641 \u067E\u0631\u0648\u0641\u0627\u0626\u0644 \u0645\u06CC\u06BA \u0631\u06C1\u062A\u06D2 \u06C1\u06CC\u06BA\u06D4"}},
{{L"Uninstall keeps your settings and data unless you choose to remove them.", L"La d\u00E9sinstallation conserve vos param\u00E8tres et vos donn\u00E9es, sauf si vous choisissez de les supprimer.", L"La desinstalaci\u00F3n conserva tu configuraci\u00F3n y tus datos, salvo que elijas quitarlos.", L"\u5378\u8F7D\u4F1A\u4FDD\u7559\u4F60\u7684\u8BBE\u7F6E\u548C\u6570\u636E\uFF0C\u9664\u975E\u4F60\u9009\u62E9\u5220\u9664\u5B83\u4EEC\u3002", L"\u0905\u0928\u0907\u0902\u0938\u094D\u091F\u0949\u0932 \u0906\u092A\u0915\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u0914\u0930 \u0921\u0947\u091F\u093E \u0930\u0916\u0924\u093E \u0939\u0948, \u091C\u092C \u0924\u0915 \u0906\u092A \u0909\u0928\u094D\u0939\u0947\u0902 \u0939\u091F\u093E\u0928\u093E \u0928 \u091A\u0941\u0928\u0947\u0902\u0964", L"A desinstala\u00E7\u00E3o mant\u00E9m suas configura\u00E7\u00F5es e dados, a menos que voc\u00EA escolha remov\u00EA-los.", L"\u041F\u0440\u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0438 \u0432\u0430\u0448\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438 \u0434\u0430\u043D\u043D\u044B\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F, \u0435\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0435 \u0438\u0445 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435.", L"\u062A\u064F\u0628\u0642\u064A \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0625\u0639\u062F\u0627\u062F\u0627\u062A\u0643 \u0648\u0628\u064A\u0627\u0646\u0627\u062A\u0643 \u0645\u0627 \u0644\u0645 \u062A\u062E\u062A\u0631 \u0625\u0632\u0627\u0644\u062A\u0647\u0627.", L"\u0986\u09A8\u0987\u09A8\u09B8\u09CD\u099F\u09B2 \u0995\u09B0\u09B2\u09C7 \u0986\u09AA\u09A8\u09BE\u09B0 \u09B8\u09C7\u099F\u09BF\u0982\u09B8 \u0993 \u09A1\u09C7\u099F\u09BE \u09A5\u09C7\u0995\u09C7 \u09AF\u09BE\u09AF\u09BC, \u09AF\u09A6\u09BF \u09A8\u09BE \u0986\u09AA\u09A8\u09BF \u09B8\u09C7\u0997\u09C1\u09B2\u09CB \u09AE\u09C1\u099B\u09A4\u09C7 \u09AC\u09C7\u099B\u09C7 \u09A8\u09C7\u09A8\u0964", L"\u0627\u064E\u0646 \u0627\u0646\u0633\u0679\u0627\u0644 \u06A9\u0631\u0646\u06D2 \u067E\u0631 \u0622\u067E \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0627\u0648\u0631 \u0688\u06CC\u0679\u0627 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06C1\u062A\u0627 \u06C1\u06D2\u060C \u062C\u0628 \u062A\u06A9 \u0622\u067E \u0627\u0646\u06C1\u06CC\u06BA \u06C1\u0679\u0627\u0646\u0627 \u0645\u0646\u062A\u062E\u0628 \u0646\u06C1 \u06A9\u0631\u06CC\u06BA\u06D4"}},
{{L"Repair restores this package's files and keeps your settings. If Aether Shell left the Windows taskbar hidden, repair restores it.", L"La r\u00E9paration r\u00E9tablit les fichiers de ce paquet et conserve vos param\u00E8tres. Si Aether Shell a laiss\u00E9 la barre des t\u00E2ches Windows masqu\u00E9e, la r\u00E9paration la r\u00E9tablit.", L"La reparaci\u00F3n restaura los archivos de este paquete y conserva tu configuraci\u00F3n. Si Aether Shell dej\u00F3 oculta la barra de tareas de Windows, la reparaci\u00F3n la restaura.", L"\u4FEE\u590D\u4F1A\u8FD8\u539F\u6B64\u5B89\u88C5\u5305\u7684\u6587\u4EF6\u5E76\u4FDD\u7559\u4F60\u7684\u8BBE\u7F6E\u3002\u5982\u679C Aether Shell \u8BA9 Windows \u4EFB\u52A1\u680F\u4FDD\u6301\u9690\u85CF\uFF0C\u4FEE\u590D\u4E5F\u4F1A\u5C06\u5176\u6062\u590D\u3002", L"\u0938\u0941\u0927\u093E\u0930 \u0907\u0938 \u092A\u0948\u0915\u0947\u091C \u0915\u0940 \u092B\u093C\u093E\u0907\u0932\u0947\u0902 \u092C\u0939\u093E\u0932 \u0915\u0930\u0924\u093E \u0939\u0948 \u0914\u0930 \u0906\u092A\u0915\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u0930\u0916\u0924\u093E \u0939\u0948\u0964 \u0905\u0917\u0930 Aether Shell \u0928\u0947 Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u091B\u093F\u092A\u093E \u091B\u094B\u0921\u093C\u093E \u0939\u094B, \u0924\u094B \u0938\u0941\u0927\u093E\u0930 \u0909\u0938\u0947 \u092C\u0939\u093E\u0932 \u0915\u0930\u0924\u093E \u0939\u0948\u0964", L"O reparo restaura os arquivos deste pacote e mant\u00E9m suas configura\u00E7\u00F5es. Se o Aether Shell deixou a barra de tarefas do Windows oculta, o reparo a restaura.", L"\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0444\u0430\u0439\u043B\u044B \u044D\u0442\u043E\u0433\u043E \u043F\u0430\u043A\u0435\u0442\u0430 \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0432\u0430\u0448\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B. \u0415\u0441\u043B\u0438 Aether Shell \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u0447 Windows \u0441\u043A\u0440\u044B\u0442\u043E\u0439, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u0451\u0442 \u0435\u0451.", L"\u064A\u0633\u062A\u0639\u064A\u062F \u0627\u0644\u0625\u0635\u0644\u0627\u062D \u0645\u0644\u0641\u0627\u062A \u0647\u0630\u0647 \u0627\u0644\u062D\u0632\u0645\u0629 \u0648\u064A\u064F\u0628\u0642\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A\u0643. \u0648\u0625\u0630\u0627 \u062A\u0631\u0643 Aether Shell \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows \u0645\u062E\u0641\u064A\u064B\u0627 \u0641\u0625\u0646 \u0627\u0644\u0625\u0635\u0644\u0627\u062D \u064A\u0639\u064A\u062F\u0647.", L"\u09AE\u09C7\u09B0\u09BE\u09AE\u09A4 \u098F\u0987 \u09AA\u09CD\u09AF\u09BE\u0995\u09C7\u099C\u09C7\u09B0 \u09AB\u09BE\u0987\u09B2 \u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u0986\u09A8\u09C7 \u098F\u09AC\u0982 \u0986\u09AA\u09A8\u09BE\u09B0 \u09B8\u09C7\u099F\u09BF\u0982\u09B8 \u09B0\u09BE\u0996\u09C7\u0964 Aether Shell Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09B2\u09C1\u0995\u09BE\u09A8\u09CB \u0985\u09AC\u09B8\u09CD\u09A5\u09BE\u09AF\u09BC \u09B0\u09C7\u0996\u09C7 \u0997\u09C7\u09B2\u09C7 \u09AE\u09C7\u09B0\u09BE\u09AE\u09A4 \u09B8\u09C7\u099F\u09BF \u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u0986\u09A8\u09C7\u0964", L"\u0645\u0631\u0645\u062A \u0627\u0633 \u067E\u06CC\u06A9\u062C \u06A9\u06CC \u0641\u0627\u0626\u0644\u06CC\u06BA \u0628\u062D\u0627\u0644 \u06A9\u0631\u062A\u06CC \u06C1\u06D2 \u0627\u0648\u0631 \u0622\u067E \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06A9\u06BE\u062A\u06CC \u06C1\u06D2\u06D4 \u0627\u06AF\u0631 Aether Shell \u0646\u06D2 Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u0686\u06BE\u067E\u0627 \u06C1\u0648\u0627 \u0686\u0