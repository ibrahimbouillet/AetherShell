{{L"Show audio output", L"Afficher la sortie audio", L"Mostrar la salida de audio", L"\u663E\u793A\u97F3\u9891\u8F93\u51FA", L"\u0911\u0921\u093F\u092F\u094B \u0906\u0909\u091F\u092A\u0941\u091F \u0926\u093F\u0916\u093E\u090F\u0901"}},
