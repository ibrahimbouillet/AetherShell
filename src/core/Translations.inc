{{L"Weather itself is turned on in Weather settings.", L"La m\u00E9t\u00E9o elle-m\u00EAme s'active dans les param\u00E8tres M\u00E9t\u00E9o.", L"El tiempo se activa en la configuraci\u00F3n del Tiempo.", L"\u5929\u6C14\u529F\u80FD\u672C\u8EAB\u9700\u5728\u201C\u5929\u6C14\u201D\u8BBE\u7F6E\u4E2D\u5F00\u542F\u3002", L"\u092E\u094C\u0938\u092E \u0916\u0941\u0926 \u092E\u094C\u0938\u092E \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0947\u0902 \u091A\u093E\u0932\u0942 \u0915\u093F\u092F\u093E \u091C\u093E\u0924\u093E \u0939\u0948\u0964"}},
{{L"Show hidden icons button", L"Afficher le bouton des ic\u00F4nes cach\u00E9es", L"Mostrar el bot\u00F3n de iconos ocultos", L"\u663E\u793A\u9690\u85CF\u56FE\u6807\u6309\u94AE", L"\u091B\u093F\u092A\u0947 \u0939\u0941\u090F \u0906\u0907\u0915\u0928 \u0915\u093E \u092C\u091F\u0928 \u0926\u093F\u0916\u093E\u090F\u0901"}},
{{L"A small chevron that opens Windows' hidden notification-area icons.", L"Un petit chevron qui ouvre les ic\u00F4nes cach\u00E9es de la zone de notification de Windows.", L"Una peque\u00F1a flecha que abre los iconos ocultos del \u00E1rea de notificaci\u00F3n de Windows.", L"\u4E00\u4E2A\u5C0F\u7BAD\u5934\uFF0C\u7528\u4E8E\u6253\u5F00 Windows \u901A\u77E5\u533A\u57DF\u4E2D\u7684\u9690\u85CF\u56FE\u6807\u3002", L"\u090F\u0915 \u091B\u094B\u091F\u093E \u0936\u0947\u0935\u0930\u0949\u0928 \u091C\u094B Windows \u0915\u0947 \u0938\u0942\u091A\u0928\u093E \u0915\u094D\u0937\u0947\u0924\u094D\u0930 \u0915\u0947 \u091B\u093F\u092A\u0947 \u0939\u0941\u090F \u0906\u0907\u0915\u0928 \u0916\u094B\u0932\u0924\u093E \u0939\u0948\u0964"}},
