{{L"The Windows taskbar was restored to its saved state.", L"La barre des t\u00E2ches Windows a \u00E9t\u00E9 r\u00E9tablie dans son \u00E9tat enregistr\u00E9.", L"La barra de tareas de Windows se restaur\u00F3 a su estado guardado.", L"Windows \u4EFB\u52A1\u680F\u5DF2\u6062\u590D\u5230\u4FDD\u5B58\u7684\u72B6\u6001\u3002", L"Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u0905\u092A\u0928\u0940 \u0938\u0939\u0947\u091C\u0940 \u0917\u0908 \u0938\u094D\u0925\u093F\u0924\u093F \u092E\u0947\u0902 \u092C\u0939\u093E\u0932 \u0939\u0941\u0906\u0964", L"A barra de tarefas do Windows foi restaurada ao estado salvo.", L"\u041F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u0447 Windows \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438.", L"\u062A\u0645\u062A \u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows \u0625\u0644\u0649 \u062D\u0627\u0644\u062A\u0647 \u0627\u0644\u0645\u062D\u0641\u0648\u0638\u0629.", L"Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09A4\u09BE\u09B0 \u09B8\u0982\u09B0\u0995\u09CD\u09B7\u09BF\u09A4 \u0985\u09AC\u09B8\u09CD\u09A5\u09BE\u09AF\u09BC \u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u0986\u09A8\u09BE \u09B9\u09AF\u09BC\u09C7\u099B\u09C7\u0964", L"Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u0627\u067E\u0646\u06CC \u0645\u062D\u0641\u0648\u0638 \u0634\u062F\u06C1 \u062D\u0627\u0644\u062A \u0645\u06CC\u06BA \u0628\u062D\u0627\u0644 \u06A9\u0631 \u062F\u06CC\u0627 \u06AF\u06CC\u0627\u06D4"}},
{{L"No saved taskbar state was found. The Windows taskbar was made visible; its auto-hide setting was not changed.", L"Aucun \u00E9tat enregistr\u00E9 de la barre des t\u00E2ches n'a \u00E9t\u00E9 trouv\u00E9. La barre des t\u00E2ches Windows a \u00E9t\u00E9 rendue visible ; son r\u00E9glage de masquage automatique n'a pas \u00E9t\u00E9 modifi\u00E9.", L"No se encontr\u00F3 ning\u00FAn estado guardado de la barra de tareas. Se hizo visible la barra de tareas de Windows; no se cambi\u00F3 su ocultaci\u00F3n autom\u00E1tica.", L"\u672A\u627E\u5230\u5DF2\u4FDD\u5B58\u7684\u4EFB\u52A1\u680F\u72B6\u6001\u3002\u5DF2\u663E\u793A Windows \u4EFB\u52A1\u680F\uFF1B\u5176\u81EA\u52A8\u9690\u85CF\u8BBE\u7F6E\u672A\u66F4\u6539\u3002", L"\u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u0915\u0940 \u0915\u094B\u0908 \u0938\u0939\u0947\u091C\u0940 \u0938\u094D\u0925\u093F\u0924\u093F \u0928\u0939\u0940\u0902 \u092E\u093F\u0932\u0940\u0964 Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u0926\u093F\u0916\u093E\u092F\u093E \u0917\u092F\u093E; \u0909\u0938\u0915\u0940 \u0911\u091F\u094B-\u0939\u093E\u0907\u0921 \u0938\u0947\u091F\u093F\u0902\u0917 \u0928\u0939\u0940\u0902 \u092C\u0926\u0932\u0940 \u0917\u0908\u0964", L"Nenhum estado salvo da barra de tarefas foi encontrado. A barra de tarefas do Windows foi tornada vis\u00EDvel; sua configura\u00E7\u00E3o de ocultar automaticamente n\u00E3o foi alterada.", L"\u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E. \u041F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u0447 Windows \u0441\u0434\u0435\u043B\u0430\u043D\u0430 \u0432\u0438\u0434\u0438\u043C\u043E\u0439; \u0435\u0451 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u043A\u0440\u044B\u0442\u0438\u044F \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0451\u043D.", L"\u0644\u0645 \u064A\u062A\u0645 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u0649 \u062D\u0627\u0644\u0629 \u0645\u062D\u0641\u0648\u0638\u0629 \u0644\u0634\u0631\u064A\u0637 \u0627\u0644\u0645\u0647\u0627\u0645. \u062A\u0645 \u0625\u0638\u0647\u0627\u0631 \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows\u061B \u0648\u0644\u0645 \u064A\u062A\u063A\u064A\u0631 \u0625\u0639\u062F\u0627\u062F \u0627\u0644\u0625\u062E\u0641\u0627\u0621 \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0627\u0644\u062E\u0627\u0635 \u0628\u0647.", L"\u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0\u09C7\u09B0 \u0995\u09CB\u09A8\u09CB \u09B8\u0982\u09B0\u0995\u09CD\u09B7\u09BF\u09A4 \u0985\u09AC\u09B8\u09CD\u09A5\u09BE \u09AA\u09BE\u0993\u09AF\u09BC\u09BE \u09AF\u09BE\u09AF\u09BC\u09A8\u09BF\u0964 Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09A6\u09C3\u09B6\u09CD\u09AF\u09AE\u09BE\u09A8 \u0995\u09B0\u09BE \u09B9\u09AF\u09BC\u09C7\u099B\u09C7; \u098F\u09B0 \u09B8\u09CD\u09AC\u09AF\u09BC\u0982\u0995\u09CD\u09B0\u09BF\u09AF\u09BC\u09AD\u09BE\u09AC\u09C7 \u09B2\u09C1\u0995\u09BE\u09A8\u09CB\u09B0 \u09B8\u09C7\u099F\u09BF\u0982 \u09AC\u09A6\u09B2\u09BE\u09A8\u09CB \u09B9\u09AF\u09BC\u09A8\u09BF\u0964", L"\u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u06CC \u06A9\u0648\u0626\u06CC \u0645\u062D\u0641\u0648\u0638 \u0634\u062F\u06C1 \u062D\u0627\u0644\u062A \u0646\u06C1\u06CC\u06BA \u0645\u0644\u06CC\u06D4 Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u0646\u0638\u0631 \u0622\u0646\u06D2 \u0648\u0627\u0644\u0627 \u0628\u0646\u0627 \u062F\u06CC\u0627 \u06AF\u06CC\u0627\u061B \u0627\u0633 \u06A9\u06CC \u062E\u0648\u062F\u06A9\u0627\u0631 \u0686\u06BE\u067E\u0627\u0646\u06D2 \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628 \u0646\u06C1\u06CC\u06BA \u0628\u062F\u0644\u06CC \u06AF\u0626\u06CC\u06D4"}},
{{L"There was nothing to restore.", L"Il n'y avait rien \u00E0 r\u00E9tablir.", L"No hab\u00EDa nada que restaurar.", L"\u6CA1\u6709\u9700\u8981\u6062\u590D\u7684\u5185\u5BB9\u3002", L"\u092C\u0939\u093E\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0915\u0941\u091B \u0928\u0939\u0940\u0902 \u0925\u093E\u0964", L"N\u00E3o havia nada para restaurar.", L"\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0431\u044B\u043B\u043E \u043D\u0435\u0447\u0435\u0433\u043E.", L"\u0644\u0645 \u064A\u0643\u0646 \u0647\u0646\u0627\u0643 \u0645\u0627 \u064A\u0645\u0643\u0646 \u0627\u0633\u062A\u0639\u0627\u062F\u062A\u0647.", L"\u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u0986\u09A8\u09BE\u09B0 \u09AE\u09A4\u09CB \u0995\u09BF\u099B\u09C1 \u099B\u09BF\u09B2 \u09A8\u09BE\u0964", L"\u0628\u062D\u0627\u0644 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 \u06A9\u0686\u06BE \u0646\u06C1\u06CC\u06BA \u062A\u06BE\u0627\u06D4"}},
{{L"Taskbar replacement is turned off.", L"Le remplacement de la barre des t\u00E2ches est d\u00E9sactiv\u00E9.", L"La sustituci\u00F3n de la barra de tareas est\u00E1 desactivada.", L"\u4EFB\u52A1\u680F\u66FF\u6362\u5DF2\u5173\u95ED\u3002", L"\u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u092A\u094D\u0930\u0924\u093F\u0938\u094D\u0925\u093E\u092A\u0928 \u092C\u0902\u0926 \u0939\u0948\u0964", L"A substitui\u00E7\u00E3o da barra de tarefas est\u00E1 desativada.", L"\u0417\u0430\u043C\u0435\u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u0430.", L"\u0627\u0633\u062A\u0628\u062F\u0627\u0644 \u0634\u0631\u064A\u0637 \u0627\u0644\u0645\u0647\u0627\u0645 \u0645\u062A\u0648\u0642\u0641.", L"\u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09AA\u09CD\u09B0\u09A4\u09BF\u09B8\u09CD\u09A5\u09BE\u09AA\u09A8 \u09AC\u09A8\u09CD\u09A7 \u0986\u099B\u09C7\u0964", L"\u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u0627 \u0645\u062A\u0628\u0627\u062F\u0644 \u0628\u0646\u062F \u06C1\u06D2\u06D4"}},
{{L"Taskbar replacement could not be turned off automatically. Turn it off in Aether Shell Settings > Desktop.", L"Le remplacement de la barre des t\u00E2ches n'a pas pu \u00EAtre d\u00E9sactiv\u00E9 automatiquement. D\u00E9sactivez-le dans Param\u00E8tres d'Aether Shell > Bureau.", L"No se pudo desactivar autom\u00E1ticamente la sustituci\u00F3n de la barra de tareas. Desact\u00EDvala en Configuraci\u00F3n de Aether Shell > Escritorio.", L"\u65E0\u6CD5\u81EA\u52A8\u5173\u95ED\u4EFB\u52A1\u680F\u66FF\u6362\u3002\u8BF7\u5728 Aether Shell \u8BBE\u7F6E > \u684C\u9762 \u4E2D\u5C06\u5176\u5173\u95ED\u3002", L"\u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u092A\u094D\u0930\u0924\u093F\u0938\u094D\u0925\u093E\u092A\u0928 \u0905\u092A\u0928\u0947-\u0906\u092A \u092C\u0902\u0926 \u0928\u0939\u0940\u0902 \u0939\u094B \u0938\u0915\u093E\u0964 \u0907\u0938\u0947 Aether Shell \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 > \u0921\u0947\u0938\u094D\u0915\u091F\u0949\u092A \u092E\u0947\u0902 \u092C\u0902\u0926 \u0915\u0930\u0947\u0902\u0964", L"N\u00E3o foi poss\u00EDvel desativar a substitui\u00E7\u00E3o da barra de tarefas automaticamente. Desative-a em Configura\u00E7\u00F5es do Aether Shell > \u00C1rea de trabalho.", L"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0437\u0430\u043C\u0435\u043D\u0443 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447. \u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0435\u0451 \u0432 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445 Aether Shell > \u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0441\u0442\u043E\u043B.", L"\u062A\u0639\u0630\u0651\u0631 \u0625\u064A\u0642\u0627\u0641 \u0627\u0633\u062A\u0628\u062F\u0627\u0644 \u0634\u0631\u064A\u0637 \u0627\u0644\u0645\u0647\u0627\u0645 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627. \u0623\u0648\u0642\u0641\u06