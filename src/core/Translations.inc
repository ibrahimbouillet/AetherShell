{{L"Your Windows taskbar choice is kept. A backup of the current settings file is kept.", L"Votre choix concernant la barre des t\u00E2ches Windows est conserv\u00E9. Une sauvegarde du fichier de param\u00E8tres actuel est conserv\u00E9e.", L"Se conserva tu elecci\u00F3n sobre la barra de tareas de Windows. Se guarda una copia de seguridad del archivo de configuraci\u00F3n actual.", L"\u4F60\u5BF9 Windows \u4EFB\u52A1\u680F\u7684\u9009\u62E9\u4F1A\u4FDD\u7559\u3002\u5F53\u524D\u8BBE\u7F6E\u6587\u4EF6\u7684\u5907\u4EFD\u4E5F\u4F1A\u4FDD\u7559\u3002", L"Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u0915\u094B \u0932\u0947\u0915\u0930 \u0906\u092A\u0915\u0940 \u092A\u0938\u0902\u0926 \u092C\u0928\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948\u0964 \u092E\u094C\u091C\u0942\u0926\u093E \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092B\u093C\u093E\u0907\u0932 \u0915\u093E \u092C\u0948\u0915\u0905\u092A \u0930\u0916\u093E \u091C\u093E\u0924\u093E \u0939\u0948\u0964", L"Sua escolha sobre a barra de tarefas do Windows \u00E9 mantida. Um backup do arquivo de configura\u00E7\u00F5es atual \u00E9 mantido.", L"\u0412\u0430\u0448 \u0432\u044B\u0431\u043E\u0440 \u043F\u043E \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447 Windows \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F. \u0420\u0435\u0437\u0435\u0440\u0432\u043D\u0430\u044F \u043A\u043E\u043F\u0438\u044F \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0444\u0430\u0439\u043B\u0430 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430.", L"\u064A\u062A\u0645 \u0627\u0644\u0627\u062D\u062A\u0641\u0627\u0638 \u0628\u0627\u062E\u062A\u064A\u0627\u0631\u0643 \u0628\u0634\u0623\u0646 \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows. \u0648\u064A\u062A\u0645 \u0627\u0644\u0627\u062D\u062A\u0641\u0627\u0638 \u0628\u0646\u0633\u062E\u0629 \u0627\u062D\u062A\u064A\u0627\u0637\u064A\u0629 \u0645\u0646 \u0645\u0644\u0641 \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u062D\u0627\u0644\u064A.", L"Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09A8\u09BF\u09AF\u09BC\u09C7 \u0986\u09AA\u09A8\u09BE\u09B0 \u09AA\u099B\u09A8\u09CD\u09A6 \u09B0\u09BE\u0996\u09BE \u09B9\u09AC\u09C7\u0964 \u09AC\u09B0\u09CD\u09A4\u09AE\u09BE\u09A8 \u09B8\u09C7\u099F\u09BF\u0982\u09B8 \u09AB\u09BE\u0987\u09B2\u09C7\u09B0 \u098F\u0995\u099F\u09BF \u09AC\u09CD\u09AF\u09BE\u0995\u0986\u09AA \u09B0\u09BE\u0996\u09BE \u09B9\u09AC\u09C7\u0964", L"Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u06D2 \u0628\u0627\u0631\u06D2 \u0645\u06CC\u06BA \u0622\u067E \u06A9\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06C1\u06D2 \u06AF\u0627\u06D4 \u0645\u0648\u062C\u0648\u062F\u06C1 \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u06A9\u06CC \u0641\u0627\u0626\u0644 \u06A9\u0627 \u0628\u06CC\u06A9 \u0627\u067E \u0631\u06A9\u06BE\u0627 \u062C\u0627\u0626\u06D2 \u06AF\u0627\u06D4"}},
