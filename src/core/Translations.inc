{{L"Pinned applications saved.", L"Applications \u00E9pingl\u00E9es enregistr\u00E9es.", L"Aplicaciones ancladas guardadas.", L"\u5DF2\u4FDD\u5B58\u56FA\u5B9A\u7684\u5E94\u7528\u3002", L"\u092A\u093F\u0928 \u0915\u093F\u090F \u0917\u090F \u0910\u092A\u094D\u0932\u093F\u0915\u0947\u0936\u0928 \u0938\u0939\u0947\u091C\u0947 \u0917\u090F\u0964", L"Aplicativos fixados salvos.", L"\u0417\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0435 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B.", L"\u062A\u0645 \u062D\u0641\u0638 \u0627\u0644\u062A\u0637\u0628\u064A\u0642\u0627\u062A \u0627\u0644\u0645\u062B\u0628\u062A\u0629.", L"\u09AA\u09BF\u09A8 \u0995\u09B0\u09BE \u0985\u09CD\u09AF\u09BE\u09AA \u09B8\u0982\u09B0\u0995\u09CD\u09B7\u09BF\u09A4 \u09B9\u09AF\u09BC\u09C7\u099B\u09C7\u0964", L"\u067E\u0646 \u0634\u062F\u06C1 \u0627\u06CC\u067E\u0633 \u0645\u062D\u0641\u0648\u0638 \u06C1\u0648 \u06AF\u0626\u06CC\u06BA\u06D4"}},
