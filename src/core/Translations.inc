{{L"The forecast for where you are, to about 100 m, with its own height. Off: rounded to about 10 km.", L"La pr\u00E9vision pour l'endroit o\u00F9 vous \u00EAtes, \u00E0 environ 100 m pr\u00E8s, avec son altitude. D\u00E9sactiv\u00E9 : arrondie \u00E0 environ 10 km.", L"El pron\u00F3stico para donde est\u00E1s, con unos 100 m de precisi\u00F3n y su propia altitud. Desactivado: redondeado a unos 10 km.", L"\u9488\u5BF9\u4F60\u6240\u5728\u4F4D\u7F6E\u7684\u9884\u62A5\uFF0C\u7CBE\u786E\u5230\u7EA6 100 \u7C73\uFF0C\u5E76\u4F7F\u7528\u5F53\u5730\u6D77\u62D4\u3002\u5173\u95ED\u65F6\uFF1A\u53D6\u6574\u5230\u7EA6 10 \u516C\u91CC\u3002", L"\u0906\u092A \u091C\u0939\u093E\u0901 \u0939\u0948\u0902 \u0935\u0939\u093E\u0901 \u0915\u093E \u092A\u0942\u0930\u094D\u0935\u093E\u0928\u0941\u092E\u093E\u0928, \u0932\u0917\u092D\u0917 100 \u092E\u0940\u091F\u0930 \u0924\u0915 \u0938\u091F\u0940\u0915, \u0909\u0938\u0915\u0940 \u0905\u092A\u0928\u0940 \u090A\u0901\u091A\u093E\u0908 \u0915\u0947 \u0938\u093E\u0925\u0964 \u092C\u0902\u0926: \u0932\u0917\u092D\u0917 10 \u0915\u093F\u092E\u0940 \u0924\u0915 \u092A\u0942\u0930\u094D\u0923\u093E\u0902\u0915\u093F\u0924\u0964", L"A previs\u00E3o para onde voc\u00EA est\u00E1, com precis\u00E3o de cerca de 100 m e a altitude do local. Desativado: arredondada para cerca de 10 km.", L"\u041F\u0440\u043E\u0433\u043D\u043E\u0437 \u0434\u043B\u044F \u043C\u0435\u0441\u0442\u0430, \u0433\u0434\u0435 \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C, \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u043A\u043E\u043B\u043E 100 \u043C \u0438 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0435\u0433\u043E \u0432\u044B\u0441\u043E\u0442\u044B. \u0412\u044B\u043A\u043B.: \u043E\u043A\u0440\u0443\u0433\u043B\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0434\u043E 10 \u043A\u043C.", L"\u0627\u0644\u062A\u0648\u0642\u0639\u0627\u062A \u0644\u0645\u0643\u0627\u0646 \u0648\u062C\u0648\u062F\u0643 \u0628\u062F\u0642\u0629 \u0646\u062D\u0648 100 \u0645 \u0648\u0645\u0639 \u0627\u0631\u062A\u0641\u0627\u0639\u0647. \u0639\u0646\u062F \u0627\u0644\u0625\u064A\u0642\u0627\u0641: \u062A\u064F\u0642\u0631\u064E\u0651\u0628 \u0625\u0644\u0649 \u0646\u062D\u0648 10 \u0643\u0645.", L"\u0986\u09AA\u09A8\u09BF \u09AF\u09C7\u0996\u09BE\u09A8\u09C7 \u0986\u099B\u09C7\u09A8 \u09B8\u09C7\u0996\u09BE\u09A8\u0995\u09BE\u09B0 \u09AA\u09C2\u09B0\u09CD\u09AC\u09BE\u09AD\u09BE\u09B8, \u09AA\u09CD\u09B0\u09BE\u09AF\u09BC 100 \u09AE\u09BF\u099F\u09BE\u09B0 \u09A8\u09BF\u09B0\u09CD\u09AD\u09C1\u09B2\u09A4\u09BE\u09AF\u09BC, \u09B8\u09C7\u0987 \u099C\u09BE\u09AF\u09BC\u0997\u09BE\u09B0 \u0989\u099A\u09CD\u099A\u09A4\u09BE\u09B8\u09B9\u0964 \u09AC\u09A8\u09CD\u09A7: \u09AA\u09CD\u09B0\u09BE\u09AF\u09BC 10 \u0995\u09BF\u09AE\u09BF \u09AA\u09B0\u09CD\u09AF\u09A8\u09CD\u09A4 \u09B0\u09BE\u0989\u09A8\u09CD\u09A1 \u0995\u09B0\u09BE\u0964", L"\u062C\u06C1\u0627\u06BA \u0622\u067E \u06C1\u06CC\u06BA \u0648\u06C1\u0627\u06BA \u06A9\u06CC \u067E\u06CC\u0634\u06AF\u0648\u0626\u06CC\u060C \u062A\u0642\u0631\u06CC\u0628\u0627\u064B 100 \u0645\u06CC\u0679\u0631 \u062A\u06A9 \u062F\u0631\u0633\u062A\u060C \u0627\u0633 \u062C\u06AF\u06C1 \u06A9\u06CC \u0627\u067E\u0646\u06CC \u0628\u0644\u0646\u062F\u06CC \u06A9\u06D2 \u0633\u0627\u062A\u06BE\u06D4 \u0628\u0646\u062F: \u062A\u0642\u0631\u06CC\u0628\u0627\u064B 10 \u06A9\u0644\u0648\u0645\u06CC\u0679\u0631 \u062A\u06A9 \u06AF\u0648\u0644\u06D4"}},
