{{L"Reversible replacement of the Windows taskbar by the Dock.", L"Remplacement r\u00E9versible de la barre des t\u00E2ches Windows par le Dock.", L"Sustituci\u00F3n reversible de la barra de tareas de Windows por el Dock.", L"\u7528\u7A0B\u5E8F\u575E\u53EF\u9006\u5730\u66FF\u6362 Windows \u4EFB\u52A1\u680F\u3002", L"\u0921\u0949\u0915 \u0926\u094D\u0935\u093E\u0930\u093E Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u0915\u093E \u0909\u0932\u091F\u093E \u091C\u093E \u0938\u0915\u0928\u0947 \u0935\u093E\u0932\u093E \u092A\u094D\u0930\u0924\u093F\u0938\u094D\u0925\u093E\u092A\u0928\u0964", L"Substitui\u00E7\u00E3o revers\u00EDvel da barra de tarefas do Windows pelo Dock.", L"\u041E\u0431\u0440\u0430\u0442\u0438\u043C\u0430\u044F \u0437\u0430\u043C\u0435\u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447 Windows \u043D\u0430 Dock.", L"\u0627\u0633\u062A\u0628\u062F\u0627\u0644 \u0642\u0627\u0628\u0644 \u0644\u0644\u062A\u0631\u0627\u062C\u0639 \u0644\u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows \u0628\u0640 Dock.", L"Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0\u09C7\u09B0 \u09AC\u09A6\u09B2\u09C7 Dock-\u098F\u09B0 \u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u09A8\u09C7\u0993\u09AF\u09BC\u09BE \u09AF\u09BE\u09AF\u09BC \u098F\u09AE\u09A8 \u09AA\u09CD\u09B0\u09A4\u09BF\u09B8\u09CD\u09A5\u09BE\u09AA\u09A8\u0964", L"Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u06CC \u062C\u06AF\u06C1 Dock \u06A9\u0627 \u0642\u0627\u0628\u0644\u0650 \u0648\u0627\u067E\u0633\u06CC \u0645\u062A\u0628\u0627\u062F\u0644\u06D4"}},
{{L"Taskbar replacement", L"Remplacement de la barre des t\u00E2ches", L"Sustituci\u00F3n de la barra de tareas", L"\u66FF\u6362\u4EFB\u52A1\u680F", L"\u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u092A\u094D\u0930\u0924\u093F\u0938\u094D\u0925\u093E\u092A\u0928", L"Substitui\u00E7\u00E3o da barra de tarefas", L"\u0417\u0430\u043C\u0435\u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447", L"\u0627\u0633\u062A\u0628\u062F\u0627\u0644 \u0634\u0631\u064A\u0637 \u0627\u0644\u0645\u0647\u0627\u0645", L"\u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09AA\u09CD\u09B0\u09A4\u09BF\u09B8\u09CD\u09A5\u09BE\u09AA\u09A8", L"\u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u0627 \u0645\u062A\u0628\u0627\u062F\u0644"}},
{{L"Replace the Windows taskbar", L"Remplacer la barre des t\u00E2ches Windows", L"Sustituir la barra de tareas de Windows", L"\u66FF\u6362 Windows \u4EFB\u52A1\u680F", L"Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u092C\u0926\u0932\u0947\u0902", L"Substituir a barra de tarefas do Windows", L"\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u0447 Windows", L"\u0627\u0633\u062A\u0628\u062F\u0627\u0644 \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows", L"Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09AA\u09CD\u09B0\u09A4\u09BF\u09B8\u09CD\u09A5\u09BE\u09AA\u09A8 \u0995\u09B0\u09C1\u09A8", L"Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u062A\u0628\u062F\u06CC\u0644 \u06A9\u0631\u06CC\u06BA"}},
{{L"Changing this needs Apply.", L"Ce changement n\u00E9cessite Appliquer.", L"Este cambio requiere Aplicar.", L"\u66F4\u6539\u6B64\u9879\u9700\u8981\u70B9\u51FB\u201C\u5E94\u7528\u201D\u3002", L"\u0907\u0938\u0947 \u092C\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0932\u093E\u0917\u0942 \u0915\u0930\u0947\u0902 \u0926\u092C\u093E\u090F\u0901\u0964", L"Alterar isto exige Aplicar.", L"\u0414\u043B\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0436\u0430\u0442\u044C \u00AB\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C\u00BB.", L"\u064A\u062A\u0637\u0644\u0628 \u062A\u063A\u064A\u064A\u0631 \u0647\u0630\u0627 \u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649 \u062A\u0637\u0628\u064A\u0642.", L"\u098F\u099F\u09BF \u09AC\u09A6\u09B2\u09BE\u09A4\u09C7 \u09AA\u09CD\u09B0\u09AF\u09BC\u09CB\u0997 \u0995\u09B0\u09A4\u09C7 \u09B9\u09AC\u09C7\u0964", L"\u0627\u0633\u06D2 \u0628\u062F\u0644\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 \u0644\u0627\u06AF\u0648 \u06A9\u0631\u06CC\u06BA \u062F\u0628\u0627\u0646\u0627 \u0636\u0631\u0648\u0631\u06CC \u06C1\u06D2\u06D4"}},
{{L"While Aether Shell runs, it hides the Windows taskbar and reserves space below maximized applications.", L"Tant qu'Aether Shell fonctionne, il masque la barre des t\u00E2ches Windows et r\u00E9serve de l'espace sous les applications agrandies.", L"Mientras Aether Shell se ejecuta, oculta la barra de tareas de Windows y reserva espacio bajo las aplicaciones maximizadas.", L"Aether Shell \u8FD0\u884C\u65F6\u4F1A\u9690\u85CF Windows \u4EFB\u52A1\u680F\uFF0C\u5E76\u5728\u6700\u5927\u5316\u7684\u5E94\u7528\u4E0B\u65B9\u4FDD\u7559\u7A7A\u95F4\u3002", L"Aether Shell \u091A\u0932\u0924\u0947 \u0938\u092E\u092F Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u091B\u093F\u092A\u093E\u0924\u093E \u0939\u0948 \u0914\u0930 \u092C\u0921\u093C\u0947 \u0915\u093F\u090F \u0917\u090F \u0910\u092A\u094D\u0932\u093F\u0915\u0947\u0936\u0928\u094B\u0902 \u0915\u0947 \u0928\u0940\u091A\u0947 \u091C\u0917\u0939 \u0906\u0930\u0915\u094D\u0937\u093F\u0924 \u0915\u0930\u0924\u093E \u0939\u0948\u0964", L"Enquanto o Aether Shell est\u00E1 em execu\u00E7\u00E3o, ele oculta a barra de tarefas do Windows e reserva espa\u00E7o abaixo dos aplicativos maximizados.", L"\u041F\u043E\u043A\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 Aether Shell, \u043E\u043D \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u0434\u0430\u0447 Windows \u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u0443\u0435\u0442 \u043C\u0435\u0441\u0442\u043E \u043F\u043E\u0434 \u0440\u0430\u0437\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u043C\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u043C\u0438.", L"\u0623\u062B\u0646\u0627\u0621 \u062A\u0634\u063A\u064A\u0644 Aether Shell \u064A\u062E\u0641\u064A \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows \u0648\u064A\u062D\u062C\u0632 \u0645\u0633\u0627\u062D\u0629 \u0623\u0633\u0641\u0644 \u0627\u0644\u062A\u0637\u0628\u064A\u0642\u0627\u062A \u0627\u0644\u0645\u0643\u0628\u0651\u0631\u0629.", L"Aether Shell \u099A\u09B2\u09BE\u09B0 \u09B8\u09AE\u09AF\u09BC \u098F\u099F\u09BF Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09B2\u09C1\u0995\u09BE\u09AF\u09BC \u098F\u09AC\u0982 \u09AC\u09A1\u09BC \u0995\u09B0\u09BE \u0985\u09CD\u09AF\u09BE\u09AA\u09C7\u09B0 \u09A8\u09BF\u099A\u09C7 \u099C\u09BE\u09AF\u09BC\u0997\u09BE \u09B8\u0982\u09B0\u0995\u09CD\u09B7\u09A3 \u0995\u09B0\u09C7\u0964", L"\u062C\u0628 Aether Shell \u0686\u0644\u062A\u0627 \u06C1\u06D2 \u062A\u0648 \u06CC\u06C1 Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u0648 \u0686\u06BE\u067E\u0627\u062A\u0627 \u06C1\u06D2 \u0627\u0648\u0631 \u0628\u0691\u06CC \u06A9\u06CC \u06AF\u0626\u06CC \u0627\u06CC\u067E\u0633 \u06A9\u06D2 \u0646\u06CC\u0686\u06D2 \u062C\u06AF\u06C1 \u0645\u062E\u062A\u0635 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u06D4"}},
{{L"Windows taskbar state is restored when this mode is disabled or Aether Shell exits. A separate recovery helper also restores it if the application stops unexpectedly. If recovery fails, restart Windows Explorer in Task Manager.", L"L'\u00E9tat de la barre des t\u00E2ches Windows est r\u00E9tabli quand ce mode est d\u00E9sactiv\u00E9 ou qu'Aether Shell se ferme. Un assistant de r\u00E9cup\u00E9ration s\u00E9par\u00E9 la r\u00E9tablit aussi si l'application s'arr\u00EAte de fa\u00E7on inattendue. Si la r\u00E9cup\u00E9ration \u00E9choue, red\u00E9marrez l'Explorateur Windows dans le Gestionnaire des t\u00E2ches.", L"El estado de la barra de tareas de Windows se restablece al desactivar este modo o al cerrar Aether Shell. Un asistente de recuperaci\u00F3n independiente tambi\u00E9n la restablece si la aplicaci\u00F3n se detiene de forma inesperada. Si la recuperaci\u00F3n falla, reinicia el Explorador de Windows desde el Administrador de tareas.", L"\u5173\u95ED\u6B64\u6A21\u5F0F\u6216\u9000\u51FA Aether Shell \u65F6\uFF0C\u4F1A\u6062\u590D Windows \u4EFB\u52A1\u680F\u7684\u72B6\u6001\u3002\u5982\u679C\u5E94\u7528\u610F\u5916\u505C\u6B62\uFF0C\u72EC\u7ACB\u7684\u6062\u590D\u52A9\u624B\u4E5F\u4F1A\u5C06\u5176\u6062\u590D\u3002\u5982\u679C\u6062\u590D\u5931\u8D25\uFF0C\u8BF7\u5728\u4EFB\u52A1\u7BA1\u7406\u5668\u4E2D\u91CD\u65B0\u542F\u52A8 Windows \u8D44\u6E90\u7BA1\u7406\u5668\u3002", L"\u092F\u0939 \u092E\u094B\u0921 \u092C\u0902\u0926 \u0915\u0930\u0928\u0947 \u092F\u093E Aether Shell \u0938\u0947 \u092C\u093E\u0939\u0930 \u0928\u093F\u0915\u0932\u0928\u0947 \u092A\u0930 Windows \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u0915\u0940 \u0938\u094D\u0925\u093F\u0924\u093F \u092C\u0939\u093E\u0932 \u0939\u094B \u091C\u093E\u0924\u0940 \u0939\u0948\u0964 \u0905\u0917\u0930 \u0910\u092A\u094D\u0932\u093F\u0915\u0947\u0936\u0928 \u0905\u091A\u093E\u0928\u0915 \u0930\u0941\u0915 \u091C\u093E\u090F \u0924\u094B \u090F\u0915 \u0905\u0932\u0917 \u0930\u093F\u0915\u0935\u0930\u0940 \u0938\u0939\u093E\u092F\u0915 \u092D\u0940 \u0907\u0938\u0947 \u092C\u0939\u093E\u0932 \u0915\u0930\u0924\u093E \u0939\u0948\u0964 \u0905\u0917\u0930 \u0930\u093F\u0915\u0935\u0930\u0940 \u0935\u093F\u092B\u0932 \u0939\u094B, \u0924\u094B \u091F\u093E\u0938\u094D\u0915 \u092E\u0948\u0928\u0947\u091C\u0930 \u092E\u0947\u0902 Windows Explorer \u092B\u093F\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964", L"O estado da barra de tarefas do Windows \u00E9 restaurado quando este modo \u00E9 desativado ou o Aether Shell \u00E9 encerrado. Um auxiliar de recupera\u00E7\u00E3o separado tamb\u00E9m a restaura se o aplicativo parar inesperadamente. Se a recupera\u00E7\u00E3o falhar, reinicie o Windows Explorer no Gerenciador de Tarefas.", L"\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447 Windows \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E\u0442 \u0440\u0435\u0436\u0438\u043C \u043E\u0442\u043A\u043B\u044E\u0447\u0451\u043D \u0438\u043B\u0438 Aether Shell \u0437\u0430\u043A\u0440\u044B\u0442. \u041E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0442\u043E\u0436\u0435 \u0432\u0435\u0440\u043D\u0451\u0442 \u0435\u0451, \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F. \u0415\u0441\u043B\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C, \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A Windows \u0432 \u0434\u0438\u0441\u043F\u0435\u0442\u0447\u0435\u0440\u0435 \u0437\u0430\u0434\u0430\u0447.", L"\u062A\u064F\u0633\u062A\u0639\u0627\u062F \u062D\u0627\u0644\u0629 \u0634\u0631\u064A\u0637 \u0645\u0647\u0627\u0645 Windows \u0639\u0646\u062F \u062A\u0639\u0637\u064A\u0644 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639 \u0623\u0648 \u0625\u0646\u0647\u0627\u0621 Aether Shell. \u0648\u064A\u0639\u064A\u062F\u0647\u0627 \u0623\u064A\u0636\u064B\u0627 \u0645\u0633\u0627\u0639\u062F \u0627\u0633\u062A\u0631\u062F\u0627\u062F \u0645\u0646\u0641\u0635\u0644 \u0625\u0630\u0627 \u062A\u0648\u0642\u0641 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0639\u0644\u0649 \u0646\u062D\u0648 \u063A\u064A\u0631 \u0645\u062A\u0648\u0642\u0639. \u0648\u0625\u0630\u0627 \u0641\u0634\u0644 \u0627\u0644\u0627\u0633\u062A\u0631\u062F\u0627\u062F \u0641\u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644 \u0645\u0633\u062A\u0643\u0634\u0641 Windows \u0645\u0646 \u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u0647\u0627\u0645.", L"\u098F\u0987 \u09AE\u09CB\u09A1 \u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09B2\u09C7 \u09AC\u09BE Aether Shell \u09A5\u09C7\u0995\u09C7 \u09AC\u09C7\u09B0 \u09B9\u09B2\u09C7 Windows \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0\u09C7\u09B0 \u0985\u09AC\u09B8\u09CD\u09A5\u09BE \u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u0986\u09A8\u09BE \u09B9\u09AF\u09BC\u0964 \u0985\u09CD\u09AF\u09BE\u09AA \u09B9\u09A0\u09BE\u09CE \u09AC\u09A8\u09CD\u09A7 \u09B9\u09B2\u09C7 \u098F\u0995\u099F\u09BF \u0986\u09B2\u09BE\u09A6\u09BE \u09B0\u09BF\u0995\u09AD\u09BE\u09B0\u09BF \u09B8\u09B9\u09BE\u09AF\u09BC\u0995\u0993 \u098F\u099F\u09BF \u09AB\u09BF\u09B0\u09BF\u09AF\u09BC\u09C7 \u0986\u09A8\u09C7\u0964 \u09B0\u09BF\u0995\u09AD\u09BE\u09B0\u09BF \u09AC\u09CD\u09AF\u09B0\u09CD\u09A5 \u09B9\u09B2\u09C7 \u099F\u09BE\u09B8\u09CD\u0995 \u09AE\u09CD\u09AF\u09BE\u09A8\u09C7\u099C\u09BE\u09B0\u09C7 Windows \u098F\u0995\u09CD\u09B8\u09AA\u09CD\u09B2\u09CB\u09B0\u09BE\u09B0 \u09B0\u09BF\u09B8\u09CD\u099F\u09BE\u09B0\u09CD\u099F \u0995\u09B0\u09C1\u09A8\u0964", L"\u062C\u0628 \u06CC\u06C1 \u0645\u0648\u0688 \u0628\u0646\u062F \u06C1\u0648 \u06CC\u0627 Aether Shell \u0628\u0646\u062F \u06C1\u0648 \u062A\u0648 Windows \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u06A9\u06CC \u062D\u0627\u0644\u062A \u0628\u062D\u0627\u0644 \u06A9\u0631 \u062F\u06CC \u062C\u0627\u062A\u06CC \u06C1\u06D2\u06D4 \u0627\u06AF\u0631 \u0627\u06CC\u067E \u0627\u0686\u0627\u0646\u06A9 \u0631\u06A9 \u062C\u0627\u0626\u06D2 \u062A\u0648 \u0627\u06CC\u06A9 \u0627\u0644\u06AF \u0628\u062D\u0627\u0644\u06CC \u0645\u062F\u062F\u06AF\u0627\u0631 \u0628\u06BE\u06CC \u0627\u0633\u06D2 \u0628\u062D\u0627\u0644 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u06D4 \u0627\u06AF\u0631 \u0628\u062D\u0627\u0644\u06CC \u0646\u0627\u06A9\u0627\u0645 \u06C1\u0648 \u062A\u0648 \u0679\u0627\u0633\u06A9 \u0645\u06CC\u0646\u06CC\u062C\u0631 \u0645\u06CC\u06BA Windows \u0627\u06CC\u06A9\u0633\u067E\u0644\u0648\u0631\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"}},
{{L"Windows Settings remains the native Windows interface. Its taskbar page is not replaced by Aether Shell; configure this mode here.", L"Les Param\u00E8tres de Windows restent l'interface native de Windows. Leur page Barre des t\u00E2ches n'est pas remplac\u00E9e par Aether Shell ; r\u00E9glez ce mode ici.", L"La Configuraci\u00F3n de Windows sigue siendo la interfaz nativa de Windows. Aether Shell no sustituye su p\u00E1gina de la barra de tareas; configura este modo aqu\u00ED.", L"Windows \u8BBE\u7F6E\u4ECD\u662F Windows \u539F\u751F\u754C\u9762\u3002Aether Shell \u4E0D\u4F1A\u66FF\u6362\u5176\u4E2D\u7684\u4EFB\u52A1\u680F\u9875\u9762\uFF1B\u8BF7\u5728\u8FD9\u91CC\u914D\u7F6E\u6B64\u6A21\u5F0F\u3002", L"Windows \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0942\u0932 Windows \u0907\u0902\u091F\u0930\u092B\u093C\u0947\u0938 \u0939\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964 Aether Shell \u0909\u0938\u0915\u093E \u091F\u093E\u0938\u094D\u0915\u092C\u093E\u0930 \u092A\u0947\u091C \u0928\u0939\u0940\u0902 \u092C\u0926\u0932\u0924\u093E; \u092F\u0939 \u092E\u094B\u0921 \u092F\u0939\u0940\u0902 \u0938\u0947\u091F \u0915\u0930\u0947\u0902\u0964", L"As Configura\u00E7\u00F5es do Windows continuam sendo a interface nativa do Windows. A p\u00E1gina da barra de tarefas dela n\u00E3o \u00E9 substitu\u00EDda pelo Aether Shell; configure este modo aqui.", L"\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B Windows \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0440\u043E\u0434\u043D\u044B\u043C \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u043E\u043C Windows. \u0415\u0451 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u0447 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F Aether Shell; \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u044D\u0442\u043E\u0442 \u0440\u0435\u0436\u0438\u043C \u0437\u0434\u0435\u0441\u044C.", L"\u062A\u0638\u0644 \u0625\u0639\u062F\u0627\u062F\u0627\u062A Windows \u0647\u064A \u0648\u0627\u062C\u0647\u0629 Windows \u0627\u0644\u0623\u0635\u0644\u064A\u0629. \u0648\u0644\u0627 \u064A\u0633\u062A\u0628\u062F\u0644 Aether Shell \u0635\u0641\u062D\u0629 \u0634\u0631\u064A\u0637 \u0627\u0644\u0645\u0647\u0627\u0645 \u0641\u064A\u0647\u0627\u061B \u0627\u0636\u0628\u0637 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639 \u0647\u0646\u0627.", L"Windows \u09B8\u09C7\u099F\u09BF\u0982\u09B8-\u0987 Windows-\u098F\u09B0 \u09A8\u09BF\u099C\u09B8\u09CD\u09AC \u0987\u09A8\u09CD\u099F\u09BE\u09B0\u09AB\u09C7\u09B8 \u09A5\u09BE\u0995\u09C7\u0964 \u098F\u09B0 \u099F\u09BE\u09B8\u09CD\u0995\u09AC\u09BE\u09B0 \u09AA\u09C7\u099C Aether Shell \u09AA\u09CD\u09B0\u09A4\u09BF\u09B8\u09CD\u09A5\u09BE\u09AA\u09A8 \u0995\u09B0\u09C7 \u09A8\u09BE; \u098F\u0987 \u09AE\u09CB\u09A1 \u098F\u0996\u09BE\u09A8\u09C7\u0987 \u0995\u09A8\u09AB\u09BF\u0997\u09BE\u09B0 \u0995\u09B0\u09C1\u09A8\u0964", L"Windows \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u06C1\u06CC Windows \u06A9\u0627 \u0627\u067E\u0646\u0627 \u0627\u0646\u0679\u0631\u0641\u06CC\u0633 \u0631\u06C1\u062A\u06CC \u06C1\u06CC\u06BA\u06D4 \u0627\u0633 \u06A9\u06D2 \u0679\u0627\u0633\u06A9 \u0628\u0627\u0631 \u0635\u0641\u062D\u06D2 \u06A9\u0648 Aether Shell \u062A\u0628\u062F\u06CC\u0644 \u0646\u06C1\u06CC\u06BA \u06A9\u0631\u062A\u0627\u061B \u06CC\u06C1 \u0645\u0648\u0688 \u06CC\u06C1\u06CC\u06BA \u062A\u0631\u062A\u06CC\u0628 \u062F\u06CC\u06BA\u06D4"}},
