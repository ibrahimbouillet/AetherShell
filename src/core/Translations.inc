{{L"Create a desktop shortcut", L"Cr\u00E9er un raccourci sur le bureau", L"Crear un acceso directo en el escritorio", L"\u521B\u5EFA\u684C\u9762\u5FEB\u6377\u65B9\u5F0F", L"\u0921\u0947\u0938\u094D\u0915\u091F\u0949\u092A \u0936\u0949\u0930\u094D\u091F\u0915\u091F \u092C\u0928\u093E\u090F\u0901"}},
