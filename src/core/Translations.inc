{{L"Position, clock and the status items shown in the Top Status Bar.", L"Position, horloge et \u00E9l\u00E9ments d'\u00E9tat affich\u00E9s dans la barre d'\u00E9tat du haut.", L"Posici\u00F3n, reloj y elementos de estado de la barra superior.", L"\u9876\u90E8\u72B6\u6001\u680F\u7684\u4F4D\u7F6E\u3001\u65F6\u949F\u548C\u72B6\u6001\u9879\u3002", L"\u0936\u0940\u0930\u094D\u0937 \u0938\u094D\u091F\u0947\u091F\u0938 \u092C\u093E\u0930 \u0915\u0940 \u0938\u094D\u0925\u093F\u0924\u093F, \u0918\u0921\u093C\u0940 \u0914\u0930 \u0909\u0938\u092E\u0947\u0902 \u0926\u093F\u0916\u0928\u0947 \u0935\u093E\u0932\u0947 \u0938\u094D\u091F\u0947\u091F\u0938 \u0906\u0907\u091F\u092E\u0964", L"Posi\u00E7\u00E3o, rel\u00F3gio e os itens de status exibidos na Barra de Status superior.", L"\u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u0447\u0430\u0441\u044B \u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0435 \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u0430\u043D\u0435\u043B\u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F.", L"\u0627\u0644\u0645\u0648\u0636\u0639 \u0648\u0627\u0644\u0633\u0627\u0639\u0629 \u0648\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0645\u0639\u0631\u0648\u0636\u0629 \u0641\u064A \u0634\u0631\u064A\u0637 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0639\u0644\u0648\u064A.", L"\u0989\u09AA\u09B0\u09C7\u09B0 \u09B8\u09CD\u099F\u09CD\u09AF\u09BE\u099F\u09BE\u09B8 \u09AC\u09BE\u09B0\u09C7 \u09A6\u09C7\u0996\u09BE\u09A8\u09CB \u0985\u09AC\u09B8\u09CD\u09A5\u09BE\u09A8, \u0998\u09A1\u09BC\u09BF \u0993 \u09B8\u09CD\u099F\u09CD\u09AF\u09BE\u099F\u09BE\u09B8 \u0986\u0987\u099F\u09C7\u09AE\u0964", L"\u0627\u0648\u067E\u0631\u06CC \u0627\u0633\u0679\u06CC\u0679\u0633 \u0628\u0627\u0631 \u0645\u06CC\u06BA \u062F\u06A9\u06BE\u0627\u0626\u06CC \u062C\u0627\u0646\u06D2 