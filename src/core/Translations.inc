{{L"Maximized windows stay below the Top Bar.", L"Les fen\u00EAtres agrandies restent sous la barre du haut.", L"Las ventanas maximizadas quedan debajo de la barra superior.", L"\u6700\u5927\u5316\u7684\u7A97\u53E3\u505C\u7559\u5728\u9876\u90E8\u680F\u4E0B\u65B9\u3002", L"\u092C\u0921\u093C\u0940 \u0915\u0940 \u0917\u0908 \u0935\u093F\u0902\u0921\u094B \u0936\u0940\u0930\u094D\u0937 \u092C\u093E\u0930 \u0915\u0947 \u0928\u0940\u091A\u0947 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964", L"As janelas maximizadas ficam abaixo da Barra superior.", L"\u0420\u0430\u0437\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0435 \u043E\u043A\u043D\u0430 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0434 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u0430\u043D\u0435\u043B\u044C\u044E.", L"\u062A\u0628\u0642\u0649 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0643\u0628\u0651\u0631\u0629 \u062A\u062D\u062A \u0627\u0644\u0634\u0631\u064A\u0637 \u0627\u0644\u0639\u0644\u0648\u064A.", L"\u09AC\u09A1\u09BC \u0995\u09B0\u09BE \u0989\u0987\u09A8\u09CD\u09A1\u09CB \u0989\u09AA\u09B0\u09C7\u09B0 \u09AC\u09BE\u09B0\u09C7\u09B0 \u09A8\u09BF\u099A\u09C7 \u09A5\u09BE\u0995\u09C7\u0964", L"\u0628\u0691\u06CC \u06A9\u06CC \u06AF\u0626\u06CC \u0648\u0646\u0688\u0648\u0632 \u0627\u0648\u067E\u0631\u06CC \u0628\u0627\u0631 \u06A9\u06D2 \u0646\u06CC\u0686\u06D2 \u0631\u06C1\u062A\u06CC \u06C1\u06CC\u06BA\u06D4"}},
