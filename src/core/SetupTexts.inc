{{L"Your welcome", L"\u062A\u0631\u062D\u064A\u0628\u0643", L"\u0986\u09AA\u09A8\u09BE\u09B0 \u09B8\u09CD\u09AC\u09BE\u0997\u09A4\u09AE", L"\u0412\u0430\u0448\u0435\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435", L"\u4F60\u7684\u6B22\u8FCE\u95EE\u5019", L"\u60A8\u7684\u6B61\u8FCE", L"Va\u0161a dobrodo\u0161lica", L"Va\u0161e uv\u00EDt\u00E1n\u00ED", L"Din velkomst", L"Je welkom", L"", L"Teie tervitus", L"Tervehdyksesi", L"Votre accueil", L"Votre accueil", L"Ihre Begr\u00FC\u00DFung", L"\u03A4\u03BF \u03BA\u03B1\u03BB\u03C9\u03C3\u03CC\u03C1\u03B9\u03C3\u03BC\u03AC \u03C3\u03B1\u03C2", L"\u05E7\u05D1\u05DC\u05EA \u05D4\u05E4\u05E0\u05D9\u05DD \u05E9\u05DC\u05DA", L"\u0906\u092A\u0915\u093E \u0938\u094D\u0935\u093E\u0917\u0924", L"Az \u00D6n \u00FCdv\u00F6zl\u00E9se", L"Il tuo benvenuto", L"\u3088\u3046\u3053\u305D", L"\uD658\uC601 \uC778\uC0AC", L"J\u016Bsu sveiciens", L"J\u016Bs\u0173 pasveikinimas", L"Din velkomst", L"Twoje powitanie", L"Suas boas-vindas", L"As suas boas-vindas", L"Mesajul dvs. de bun venit", L"\u0412\u0430\u0448\u0435 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435", L"Va\u0161a dobrodo\u0161lica", L"Va\u0161e priv\u00EDtanie", L"Va\u0161 pozdrav", L"Tu bienvenida", L"Tu bienvenida", L"Din v\u00E4lkomsth\u00E4lsning", L"\u0E04\u0E33\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13", L"Kar\u015F\u0131laman\u0131z", L"\u0412\u0430\u0448\u0435 \u043F\u0440\u0438\u0432\u0456\u0442\u0430\u043D\u043D\u044F", L"\u0622\u067E \u06A9\u0627 \u062E\u06CC\u0631\u0645\u0642\u062F\u0645"}},
{{L"After you sign in or unlock your PC, Aether Shell writes a short greeting by hand. Type the name it should greet you with, or leave it empty for a simple hello.", L"\u0628\u0639\u062F \u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u062F\u062E\u0648\u0644 \u0623\u0648 \u0641\u062A\u062D \u0642\u0641\u0644 \u0627\u0644\u0643\u0645\u0628\u064A\u0648\u062A\u0631 \u064A\u0643\u062A\u0628 Aether Shell \u062A\u062D\u064A\u0629 \u0642\u0635\u064A\u0631\u0629 \u0628\u062E\u0637 \u0627\u0644\u064A\u062F. \u0627\u0643\u062A\u0628 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0630\u064A \u064A\u062D\u064A\u0651\u064A\u0643 \u0628\u0647\u060C \u0623\u0648 \u0627\u062A\u0631\u0643\u0647 \u0641\u0627\u0631\u063A\u064B\u0627 \u0644\u062A\u062D\u064A\u0629 \u0628\u0633\u064A\u0637\u0629.", L"\u0986\u09AA\u09A8\u09BF \u09B8\u09BE\u0987\u09A8 \u0987\u09A8 \u09AC\u09BE \u09AA\u09BF\u09B8\u09BF \u0986\u09A8\u09B2\u0995 \u0995\u09B0\u09BE\u09B0 \u09AA\u09B0 Aether Shell \u09B9\u09BE\u09A4\u09C7 \u098F\u0995\u099F\u09BF \u099B\u09CB\u099F \u0985\u09AD\u09BF\u09AC\u09BE\u09A6\u09A8 \u09B2\u09C7\u0996\u09C7\u0964 \u09AF\u09C7 \u09A8\u09BE\u09AE\u09C7 \u0985\u09AD\u09BF\u09AC\u09BE\u09A6\u09A8 \u099C\u09BE\u09A8\u09BE\u09AC\u09C7 \u09B8\u09C7\u099F\u09BF \u09B2\u09BF\u0996\u09C1\u09A8, \u0985\u09A5\u09AC\u09BE \u09B8\u09BE\u09A7\u09BE\u09B0\u09A3 \u09B9\u09CD\u09AF\u09BE\u09B2\u09CB\u09B0 \u099C\u09A8\u09CD\u09AF \u0996\u09BE\u09B2\u09BF \u09B0\u09BE\u0996\u09C1\u09A8\u0964", L"\u0421\u043B\u0435\u0434 \u043A\u0430\u0442\u043E \u0432\u043B\u0435\u0437\u0435\u0442\u0435 \u0438\u043B\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043A\u043E\u043C\u043F\u044E\u0442\u044A\u0440\u0430 \u0441\u0438, Aether Shell \u0438\u0437\u043F\u0438\u0441\u0432\u0430 \u043D\u0430 \u0440\u044A\u043A\u0430 \u043A\u0440\u0430\u0442\u044A\u043A \u043F\u043E\u0437\u0434\u0440\u0430\u0432. \u0412\u044A\u0432\u0435\u0434\u0435\u0442\u0435 \u0438\u043C\u0435\u0442\u043E, \u0441 \u043A\u043E\u0435\u0442\u043E \u0434\u0430 \u0432\u0438 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u044F\u0432\u0430, \u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0435\u0442\u0435 \u043F\u043E\u043B\u0435\u0442\u043E \u043F\u0440\u0430\u0437\u043D\u043E \u0437\u0430 \u043E\u0431\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u043E \u201E\u0437\u0434\u0440\u0430\u0432\u0435\u0439\u201C.", L"\u767B\u5F55\u6216\u89E3\u9501\u7535\u8111\u540E\uFF0CAether Shell \u4F1A\u624B\u5199\u4E00\u6BB5\u7B80\u77ED\u7684\u95EE\u5019\u3002\u8F93\u5165\u5B83\u95EE\u5019\u4F60\u65F6\u4F7F\u7528\u7684\u540D\u5B57\uFF0C\u6216\u7559\u7A7A\u4EE5\u7B80\u5355\u5730\u6253\u62DB\u547C\u3002", L"\u60A8\u767B\u5165\u6216\u89E3\u9664\u9396\u5B9A\u96FB\u8166\u5F8C\uFF0CAether Shell \u6703\u624B\u5BEB\u4E00\u6BB5\u7C21\u77ED\u7684\u554F\u5019\u3002\u8ACB\u8F38\u5165\u5B83\u554F\u5019\u60A8\u6642\u8981\u4F7F\u7528\u7684\u540D\u7A31\uFF0C\u6216\u4FDD\u7559\u7A7A\u767D\u4EE5\u4F7F\u7528\u7C21\u55AE\u7684 Hello\u3002", L"Nakon \u0161to se prijavite ili otklju\u010Date ra\u010Dunalo, Aether Shell rukom ispisuje kratki pozdrav. Upi\u0161ite ime kojim vas treba pozdraviti ili ostavite polje prazno za jednostavan pozdrav.", L"Po p\u0159ihl\u00E1\u0161en\u00ED nebo odemknut\u00ED po\u010D\u00EDta\u010De nap\u00ED\u0161e Aether Shell ru\u010Dn\u011B kr\u00E1tk\u00FD pozdrav. Zadejte jm\u00E9no, kter\u00FDm v\u00E1s m\u00E1 pozdravit, nebo pole nechte pr\u00E1zdn\u00E9 pro jednoduch\u00E9 ahoj.", L"N\u00E5r du logger p\u00E5 eller l\u00E5ser din pc op, skriver Aether Shell en kort hilsen i h\u00E5nden. Skriv det navn, den skal hilse dig med, eller lad feltet v\u00E6re tomt for et simpelt hej.", L"Nadat je je aanmeldt of je pc ontgrendelt, schrijft Aether Shell met de hand een korte begroeting. Typ de naam waarmee je wilt worden begroet, of laat het veld leeg voor een eenvoudig hallo.", L"", L"P\u00E4rast sisselogimist v\u00F5i arvuti lukust avamist kirjutab Aether Shell k\u00E4sitsi l\u00FChikese tervituse. Tippige nimi, millega see teid tervitab, v\u00F5i j\u00E4tke v\u00E4li lihtsa tervituse jaoks t\u00FChjaks.", L"Kun kirjaudut sis\u00E4\u00E4n tai avaat tietokoneen lukituksen, Aether Shell kirjoittaa k\u00E4sin lyhyen tervehdyksen. Kirjoita nimi, jolla se tervehtii sinua, tai j\u00E4t\u00E4 kentt\u00E4 tyhj\u00E4ksi, jolloin saat yksinkertaisen tervehdyksen.", L"Apr\u00E8s l'ouverture de session ou le d\u00E9verrouillage de votre PC, Aether Shell \u00E9crit un court message \u00E0 la main. Tapez le pr\u00E9nom avec lequel il doit vous saluer, ou laissez vide pour un simple bonjour.", L"Apr\u00E8s l'ouverture de session ou le d\u00E9verrouillage de votre PC, Aether Shell \u00E9crit un court message \u00E0 la main. Tapez le pr\u00E9nom avec lequel il doit vous saluer, ou laissez vide pour un simple bonjour.", L"Nachdem Sie sich angemeldet oder Ihren PC entsperrt haben, schreibt Aether Shell eine kurze Begr\u00FC\u00DFung von Hand. Geben Sie den Namen ein, mit dem Sie begr\u00FC\u00DFt werden m\u00F6chten, oder lassen Sie das Feld f\u00FCr ein einfaches Hallo leer.", L"\u0391\u03C6\u03BF\u03CD \u03B5\u03B9\u03C3\u03AD\u03BB\u03B8\u03B5\u03C4\u03B5 \u03AE \u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE \u03C3\u03B1\u03C2, \u03C4\u03BF Aether Shell \u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03BC\u03B5 \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9 \u03AD\u03BD\u03B1\u03BD \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03BF \u03C7\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03C3\u03BC\u03CC. \u03A0\u03BB\u03B7\u03BA\u03C4\u03C1\u03BF\u03BB\u03BF\u03B3\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03BC\u03B5 \u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF \u03B8\u03B1 \u03C3\u03B1\u03C2 \u03C7\u03B1\u03B9\u03C1\u03B5\u03C4\u03AC \u03AE \u03B1\u03C6\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF \u03BA\u03B5\u03BD\u03CC \u03B3\u03B9\u03B1 \u03AD\u03BD\u03B1 \u03B1\u03C0\u03BB\u03CC \u03B3\u03B5\u03B9\u03B1.", L"\u05DC\u05D0\u05D7\u05E8 \u05E9\u05D0\u05EA\u05D4 \u05E0\u05DB\u05E0\u05E1 \u05D0\u05D5 \u05DE\u05D1\u05D8\u05DC \u05D0\u05EA \u05E0\u05E2\u05D9\u05DC\u05EA \u05D4\u05DE\u05D7\u05E9\u05D1, Aether Shell \u05DB\u05D5\u05EA\u05D1 \u05D1\u05E8\u05DB\u05D4 \u05E7\u05E6\u05E8\u05D4 \u05D1\u05DB\u05EA\u05D1 \u05D9\u05D3. \u05D4\u05E7\u05DC\u05D3 \u05D0\u05EA \u05D4\u05E9\u05DD \u05E9\u05D1\u05D5 \u05D4\u05D5\u05D0 \u05D9\u05D1\u05E8\u05DA \u05D0\u05D5\u05EA\u05DA, \u05D0\u05D5 \u05D4\u05E9\u05D0\u05E8 \u05D0\u05EA \u05D4\u05E9\u05D3\u05D4 \u05E8\u05D9\u05E7 \u05DC\u05E9\u05DC\u05D5\u05DD \u05E4\u05E9\u05D5\u05D8.", L"\u0938\u093E\u0907\u0928 \u0907\u0928 \u0915\u0930\u0928\u0947 \u092F\u093E PC \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092C\u093E\u0926 Aether Shell \u0939\u093E\u0925 \u0938\u0947 \u090F\u0915 \u091B\u094B\u091F\u093E \u0905\u092D\u093F\u0935\u093E\u0926\u0928 \u0932\u093F\u0916\u0924\u093E \u0939\u0948\u0964 \u0935\u0939 \u0928\u093E\u092E \u0932\u093F\u0916\u0947\u0902 \u091C\u093F\u0938\u0938\u0947 \u0935\u0939 \u0906\u092A\u0915\u094B \u0905\u092D\u093F\u0935\u093E\u0926\u0928 \u0915\u0930\u0947, \u092F\u093E \u0938\u093F\u0930\u094D\u092B\u093C \u0928\u092E\u0938\u094D\u0924\u0947 \u0915\u0947 \u0932\u093F\u090F \u0916\u093E\u0932\u0940 \u091B\u094B\u0921\u093C\u0947\u0902\u0964", L"Miut\u00E1n bejelentkezik vagy feloldja a sz\u00E1m\u00EDt\u00F3g\u00E9p z\u00E1rol\u00E1s\u00E1t, az Aether Shell k\u00E9z\u00EDr\u00E1ssal r\u00F6vid \u00FCdv\u00F6zl\u00E9st \u00EDr. \u00CDrja be a nevet, amellyel k\u00F6sz\u00F6ntse, vagy hagyja \u00FCresen egy egyszer\u0171 k\u00F6sz\u00F6n\u00E9shez.", L"Dopo l'accesso o lo sblocco del PC, Aether Shell scrive a mano un breve saluto. Digita il nome con cui deve salutarti oppure lascia vuoto per un semplice ciao.", L"\u30B5\u30A4\u30F3\u30A4\u30F3\u307E\u305F\u306F PC \u306E\u30ED\u30C3\u30AF\u89E3\u9664\u306E\u5F8C\u3001Aether Shell \u304C\u77ED\u3044\u3042\u3044\u3055\u3064\u3092\u624B\u66F8\u304D\u3067\u8868\u793A\u3057\u307E\u3059\u3002\u3042\u3044\u3055\u3064\u306B\u4F7F\u3046\u540D\u524D\u3092\u5165\u529B\u3059\u308B\u304B\u3001\u30B7\u30F3\u30D7\u30EB\u306A Hello \u306B\u3059\u308B\u5834\u5408\u306F\u7A7A\u306E\u307E\u307E\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002", L"\uB85C\uADF8\uC778\uD558\uAC70\uB098 PC \uC7A0\uAE08\uC744 \uD574\uC81C\uD55C \uD6C4 Aether Shell\uC774 \uC9E7\uC740 \uC778\uC0AC\uB9D0\uC744 \uC190\uAE00\uC528\uB85C \uC501\uB2C8\uB2E4. \uC778\uC0AC\uD560 \uB54C \uC0AC\uC6A9\uD560 \uC774\uB984\uC744 \uC785\uB825\uD558\uAC70\uB098, \uAC04\uB2E8\uD55C \uC778\uC0AC\uB97C \uC6D0\uD558\uBA74 \uBE44\uC6CC \uB450\uC138\uC694.", L"P\u0113c pierakst\u012B\u0161an\u0101s vai datora atblo\u0137\u0113\u0161anas Aether Shell ar roku uzraksta \u012Bsu sveicienu. Ierakstiet v\u0101rdu, ar kuru tam j\u016Bs sveikt, vai atst\u0101jiet tuk\u0161u vienk\u0101r\u0161am \u201Csveiki\u201D.", L"Jums prisijungus arba atrakinus kompiuter\u012F, \u201EAether Shell\u201C ranka para\u0161o trump\u0105 pasveikinim\u0105. \u012Eveskite vard\u0105, kuriuo jis tur\u0117t\u0173 jus sveikinti, arba palikite tu\u0161\u010Di\u0105, kad b\u016Bt\u0173 tiesiog \u201Elabas\u201C.", L"Etter at du logger p\u00E5 eller l\u00E5ser opp PC-en, skriver Aether Shell en kort hilsen for h\u00E5nd. Skriv inn navnet den skal hilse deg med, eller la feltet st\u00E5 tomt for et enkelt hei.", L"Po zalogowaniu lub odblokowaniu komputera Aether Shell pisze odr\u0119cznie kr\u00F3tkie powitanie. Wpisz imi\u0119, kt\u00F3rym ma Ci\u0119 wita\u0107, lub pozostaw puste pole, aby otrzyma\u0107 zwyk\u0142e \u201Ecze\u015B\u0107\u201D.", L"Depois que voc\u00EA entra ou desbloqueia o PC, o Aether Shell escreve uma breve sauda\u00E7\u00E3o \u00E0 m\u00E3o. Digite o nome com que ele deve cumprimentar voc\u00EA ou deixe vazio para um simples ol\u00E1.", L"Depois de iniciar sess\u00E3o ou desbloquear o PC, o Aether Shell escreve \u00E0 m\u00E3o uma breve sauda\u00E7\u00E3o. Escreva o nome com que deve cumpriment\u00E1-lo ou deixe vazio para um simples ol\u00E1.", L"Dup\u0103 ce v\u0103 conecta\u021Bi sau debloca\u021Bi PC-ul, Aether Shell scrie de m\u00E2n\u0103 un scurt salut. Tasta\u021Bi numele cu care s\u0103 v\u0103 salute sau l\u0103sa\u021Bi c\u00E2mpul gol pentru un simplu salut.", L"\u041F\u043E\u0441\u043B\u0435 \u0432\u0445\u043E\u0434\u0430 \u0438\u043B\u0438 \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0438 \u041F\u041A Aether Shell \u043E\u0442 \u0440\u0443\u043A\u0438 \u043F\u0438\u0448\u0435\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u044F, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043A \u0432\u0430\u043C \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F, \u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u043E\u043B\u0435 \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F.", L"Nakon \u0161to se prijavite ili otklju\u010Date ra\u010Dunar, Aether Shell rukom ispisuje kratak pozdrav. Unesite ime kojim treba da vas pozdravi ili ostavite polje prazno za jednostavan pozdrav.", L"Po prihl\u00E1sen\u00ED alebo odomknut\u00ED po\u010D\u00EDta\u010Da nap\u00ED\u0161e Aether Shell ru\u010Dne kr\u00E1tky pozdrav. Zadajte meno, ktor\u00FDm v\u00E1s m\u00E1 pozdravi\u0165, alebo pole nechajte pr\u00E1zdne pre jednoduch\u00E9 ahoj.", L"Ko se vpi\u0161ete ali odklenete ra\u010Dunalnik, Aether Shell ro\u010Dno napi\u0161e kratek pozdrav. Vnesite ime, s katerim naj vas pozdravi, ali pustite polje prazno za preprost pozdrav.", L"Al iniciar sesi\u00F3n o desbloquear el PC, Aether Shell escribe a mano un breve saludo. Escribe el nombre con el que debe saludarte, o d\u00E9jalo vac\u00EDo para un simple hola.", L"Al iniciar sesi\u00F3n o desbloquear la PC, Aether Shell escribe a mano un breve saludo. Escribe el nombre con el que debe saludarte, o d\u00E9jalo vac\u00EDo para un simple hola.", L"N\u00E4r du loggar in eller l\u00E5ser upp datorn skriver Aether Shell en kort h\u00E4lsning f\u00F6r hand. Skriv namnet den ska h\u00E4lsa dig med, eller l\u00E4mna f\u00E4ltet tomt f\u00F6r ett enkelt hej.", L"\u0E2B\u0E25\u0E31\u0E07\u0E08\u0E32\u0E01\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E25\u0E07\u0E0A\u0E37\u0E48\u0E2D\u0E40\u0E02\u0E49\u0E32\u0E43\u0E0A\u0E49\u0E2B\u0E23\u0E37\u0E2D\u0E1B\u0E25\u0E14\u0E25\u0E47\u0E2D\u0E01\u0E1E\u0E35\u0E0B\u0E35 Aether Shell \u0E08\u0E30\u0E40\u0E02\u0E35\u0E22\u0E19\u0E04\u0E33\u0E17\u0E31\u0E01\u0E17\u0E32\u0E22\u0E2A\u0E31\u0E49\u0E19\u0E46 \u0E14\u0E49\u0E27\u0E22\u0E25\u0E32\u0E22\u0E21\u0E37\u0E2D \u0E1E\u0E34\u0E21\u0E1E\u0E4C\u0E0A\u0E37\u0E48\u0E2D\u0E17\u0E35\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E43\u0E2B\u0E49\u0E17\u0E31\u0E01\u0E17\u0E32\u0E22 \u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E27\u0E49\u0E19\u0E27\u0E48\u0E32\u0E07\u0E44\u0E27\u0E49\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E17\u0E31\u0E01\u0E17\u0E32\u0E22\u0E41\u0E1A\u0E1A\u0E40\u0E23\u0E35\u0E22\u0E1A\u0E07\u0E48\u0E32\u0E22", L"Oturum a\u00E7t\u0131ktan veya bilgisayar\u0131n\u0131z\u0131n kilidini a\u00E7t\u0131ktan sonra Aether Shell el yaz\u0131s\u0131yla k\u0131sa bir selamlama yazar. Sizi selamlayaca\u011F\u0131 ad\u0131 yaz\u0131n veya basit bir merhaba i\u00E7in bo\u015F b\u0131rak\u0131n.", L"\u041F\u0456\u0441\u043B\u044F \u0432\u0445\u043E\u0434\u0443 \u0430\u0431\u043E \u0440\u043E\u0437\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u041F\u041A Aether Shell \u043F\u0438\u0448\u0435 \u0432\u0456\u0434 \u0440\u0443\u043A\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0435 \u043F\u0440\u0438\u0432\u0456\u0442\u0430\u043D\u043D\u044F. \u0412\u0432\u0435\u0434\u0456\u0442\u044C \u0456\u043C\u2019\u044F, \u0437 \u044F\u043A\u0438\u043C \u0432\u0456\u043D \u043C\u0430\u0454 \u0432\u0430\u0441 \u0432\u0456\u0442\u0430\u0442\u0438, \u0430\u0431\u043E \u0437\u0430\u043B\u0438\u0448\u0442\u0435 \u043F\u043E\u043B\u0435 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u043C \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E \u00AB\u043F\u0440\u0438\u0432\u0456\u0442\u00BB.", L"\u0633\u0627\u0626\u0646 \u0627\u0646 \u06CC\u0627 \u067E\u06CC \u0633\u06CC \u0627\u0646 \u0644\u0627\u06A9 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0628\u0639\u062F Aether Shell \u06C1\u0627\u062A\u06BE \u0633\u06D2 \u0627\u06CC\u06A9 \u0645\u062E\u062A\u0635\u0631 \u0633\u0644\u0627\u0645\u06CC \u0644\u06A9\u06BE\u062A\u0627 \u06C1\u06D2\u06D4 \u0648\u06C1 \u0646\u0627\u0645 \u0644\u06A9\u06BE\u06CC\u06BA \u062C\u0633 \u0633\u06D2 \u0648\u06C1 \u0622\u067E \u06A9\u0648 \u0633\u0644\u0627\u0645 \u06A9\u0631\u06D2\u060C \u06CC\u0627 \u0633\u0627\u062F\u06C1 \u0633\u0644\u0627\u0645 \u06A9\u06D2 \u0644\u06CC\u06D2 \u062E\u0627\u0644\u06CC \u0686\u06BE\u0648\u0691 \u062F\u06CC\u06BA\u06D4"}},
