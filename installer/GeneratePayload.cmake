file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(_sources "${APP}" "${LAUNCHER}" "${UPDATER}" "${REPO}/LICENSE" "${REPO}/THIRD_PARTY_NOTICES.md")
set(_names AetherShellApp.exe AetherShell.exe AetherShellUpdater.exe LICENSE THIRD_PARTY_NOTICES.md)
set(_manifest "{\"schemaVersion\":1,\"product\":\"AetherShell\",\"version\":\"${VERSION}\",\"architecture\":\"${ARCHITECTURE}\",\"files\":[")
set(_rc "// SPDX-License-Identifier: MIT\n// Copyright (c) 2026 Ibrahim Bouillet\n")
foreach(_index RANGE 0 4)
    list(GET _sources ${_index} _source)
    list(GET _names ${_index} _name)
    file(SIZE "${_source}" _size)
    file(SHA256 "${_source}" _sha)
    if(_index GREATER 0)
        string(APPEND _manifest ",")
    endif()
    string(APPEND _manifest "{\"name\":\"${_name}\",\"resource\":\"PAYLOAD_${_index}\",\"size\":${_size},\"sha256\":\"${_sha}\"}")
    file(TO_CMAKE_PATH "${_source}" _resource_path)
    string(APPEND _rc "PAYLOAD_${_index} RCDATA \"${_resource_path}\"\n")
endforeach()
string(APPEND _manifest "]}\n")
file(WRITE "${OUTPUT_DIR}/payload-manifest.json" "${_manifest}")
string(APPEND _rc "PAYLOAD_MANIFEST RCDATA \"${OUTPUT_DIR}/payload-manifest.json\"\n")
file(WRITE "${OUTPUT_DIR}/payload.rc" "${_rc}")
