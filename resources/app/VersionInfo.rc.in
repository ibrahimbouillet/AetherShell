// Version resource shared by the Aether Shell executables (configured per target by CMake).
#pragma code_page(65001)
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @AETHER_FILE_VERSION_COMMAS@
 PRODUCTVERSION @AETHER_FILE_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ibrahim Bouillet"
            VALUE "FileDescription", "@AETHER_RC_DESCRIPTION@"
            VALUE "FileVersion", "@AETHER_VERSION_FULL@"
            VALUE "InternalName", "@AETHER_RC_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Ibrahim Bouillet. MIT License."
            VALUE "OriginalFilename", "@AETHER_RC_INTERNAL_NAME@.exe"
            VALUE "ProductName", "Aether Shell"
            VALUE "ProductVersion", "@AETHER_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_AETHER ICON "@PROJECT_SOURCE_DIR@/resources/branding/ico/AetherShell.ico"
